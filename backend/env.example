# ============================================================================
# AI News Agent - Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# LLM Provider (Required - Choose ONE)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
# OR
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_MODEL=gemini-pro
# OR
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# PostgreSQL for production (recommended)
DATABASE_URL=postgresql://user:password@localhost:5432/news_agent

# SQLite for local development (default if not set)
# DATABASE_URL=sqlite:///./news_agent.db

# ----------------------------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------------------------
SECRET_KEY=your-secret-key-change-this-to-random-string-in-production
ACCESS_TOKEN_EXPIRE_HOURS=24

# ----------------------------------------------------------------------------
# News APIs (Optional - uses LLM fallback if not set)
# ----------------------------------------------------------------------------
# Tavily (recommended - AI-optimized search)
TAVILY_API_KEY=your_tavily_api_key_here

# News API (fallback)
NEWS_API_KEY=your_news_api_key_here

# SerpAPI (secondary fallback)
SERPAPI_API_KEY=your_serpapi_api_key_here

# ----------------------------------------------------------------------------
# Email Service (Required for email notifications)
# ----------------------------------------------------------------------------
# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=notifications@yournewsagent.com

# OR Mailgun
# MAILGUN_API_KEY=your_mailgun_api_key_here
# MAILGUN_DOMAIN=mg.yournewsagent.com

# ----------------------------------------------------------------------------
# Observability (Optional - for debugging and monitoring)
# ----------------------------------------------------------------------------
# Arize AX - Complete observability for your multi-agent system
# Sign up at: https://app.arize.com/signup
# Get credentials from: Settings → API Keys
ARIZE_SPACE_ID=your_arize_space_id
ARIZE_API_KEY=your_arize_api_key

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
# Test mode (uses fake LLM responses for testing)
TEST_MODE=0

# RAG feature flag (for future local news database)
ENABLE_RAG=0

# Embeddings model for RAG
OPENAI_EMBED_MODEL=text-embedding-3-small

# ----------------------------------------------------------------------------
# Scheduler Settings
# ----------------------------------------------------------------------------
# Enable automatic daily digest generation
ENABLE_SCHEDULER=1

# Default digest generation time (UTC)
DIGEST_GENERATION_TIME=00:00

